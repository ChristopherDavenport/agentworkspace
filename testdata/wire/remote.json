      "method": "POST",
      "path": "/v1/sessions/${session}/processes",
      "type": "application/json",
      "body": {
        "args": [
          "sleep",
          "30"
        ],
        "key": "corpussleepaaaa02"
      },
      "status": 200,
      "form": "json",
      "reply": {
        "id": "corpussleepaaaa02"
      }
    },
    {
      "name": "a third, past the session's bound of two: limit",
      "token": "all",
      "method": "POST",
      "path": "/v1/sessions/${session}/processes",
      "type": "application/json",
      "body": {
        "args": [
          "sleep",
